[Unit]
Description=Frostwit server (traces stolen stock tokens and USDG on Robinhood Chain; read-only, never receives a wallet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frostwit
Group=frostwit
WorkingDirectory=/opt/frostwit/repo
Environment=NODE_ENV=production
Environment=PORT=__PORT__
Environment=HOST=127.0.0.1
Environment=STATE_DIR=/opt/frostwit/state
Environment=RPC_URL=https://rpc.mainnet.chain.robinhood.com
Environment=TOKEN_JSON=/opt/frostwit/repo/web/token.json
Environment=KNOWN_JSON=/opt/frostwit/repo/data/known.json
Environment=STOCKS_JSON=/opt/frostwit/repo/data/stocks-rc.json
Environment=DIST_DIR=/opt/frostwit/repo/web/dist
Environment=MIN_HOLD=1000000
Environment=SITE_URL=https://__DOMAIN__
ExecStart=/usr/bin/node /opt/frostwit/repo/server/src/index.mjs
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/frostwit/state
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=800M

[Install]
WantedBy=multi-user.target
